# Server Configuration
PORT=8787
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=*
ALLOWED_ORIGINS=http://localhost:5173,http://192.168.4.226:5173

# Upstash Redis Configuration
# Get these from: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_rest_token_here
UPSTASH_REDIS_URL=rediss://default:your_token@your-redis-instance.upstash.io:6379

# Session Configuration
# How long sessions persist without any activity (default: 24 hours)
SESSION_TTL_SECONDS=86400

# How long inactive participants remain in a session (default: 1 hour)
# Participants with no activity for this duration will be automatically removed
PARTICIPANT_INACTIVITY_TTL_SECONDS=3600

# JWT & HMAC Security
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_secure_random_string_here
# HMAC_MASTER_SECRET is optional and defaults to JWT_SECRET if not provided
